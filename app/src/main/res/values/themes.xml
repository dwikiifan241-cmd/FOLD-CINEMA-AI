<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Shown by the system splash (Android 12+ and the compat library below). -->
    <style name="Theme.FoldCinema.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/cinema_black</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.FoldCinema</item>
    </style>

    <style name="Theme.FoldCinema" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/cinema_black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
